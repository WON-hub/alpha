# Supabase Postgres connection string. Use the Session Pooler URL for deployed apps.
# Example: postgresql+psycopg://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./app.db

# Optional Supabase client values. The current backend uses DATABASE_URL directly.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Used to sign the admin session cookie. Generate a long random value in production.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_DAYS=7

# Optional integrations. Place search is used only by the admin registration flow.
# Choose one provider: kakao or google.
PLACE_SEARCH_PROVIDER=kakao
GOOGLE_PLACES_API_KEY=
KAKAO_REST_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# App behavior
SEED_ON_STARTUP=true
CAMPUS_LAT=37.6194
CAMPUS_LNG=127.0598
CAMPUS_NAME=광운대학교
